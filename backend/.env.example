# Copy to backend/.env and edit. Every field maps to app/config.py.

WRECKOGNISE_DEBUG=true

# --- preprocessing ---
WRECKOGNISE_DENOISE_METHOD=nlm
WRECKOGNISE_NLM_H=10.0
WRECKOGNISE_BILATERAL_DIAMETER=9
WRECKOGNISE_CLAHE_CLIP_LIMIT=2.5

# --- detection ---
WRECKOGNISE_MODEL_WEIGHTS=yolov8n-sonar.pt
WRECKOGNISE_CONFIDENCE_THRESHOLD=0.35
WRECKOGNISE_IOU_THRESHOLD=0.45

# --- ingestion ---
WRECKOGNISE_MAX_UPLOAD_MB=512

# --- georeferencing ---
# Lever arm from the GNSS antenna to the acoustic centre, bow-positive metres.
WRECKOGNISE_GPS_ANTENNA_OFFSET_M=0.0
