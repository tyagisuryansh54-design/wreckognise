# Copy to .env.local for local overrides, or set in your host's dashboard.
#
# Where the FastAPI backend lives. Leave BLANK for local development -- Vite's
# dev proxy (vite.config.js) forwards /api and /static to 127.0.0.1:8000.
#
# In production there is no proxy, so this MUST be the full backend origin,
# with no trailing slash:
#
#   VITE_API_BASE=https://wreckognise-api.onrender.com

VITE_API_BASE=
