# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/

# --- Node ---
node_modules/
dist/
.vite/
*.local

# --- Wreckognise runtime artefacts ---
backend/storage/uploads/*
backend/storage/processed/*
backend/storage/reports/*
!backend/storage/**/.gitkeep

# --- Model weights ---
*.pt
*.onnx

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# The ONNX weights (~12 MB) ARE tracked: the deployed API needs them at build
# time, and committing keeps the deploy reproducible. metrics.json is tracked
# too, so the accuracy the dashboard reports is reviewable in git.
# The .pt checkpoint stays out -- it is training-only and twice the size.
backend/models/*.pt
!backend/models/yolov8n-sonar.onnx
!backend/models/metrics.json
