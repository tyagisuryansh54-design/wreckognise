# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/

# --- Node ---
node_modules/
dist/
.vite/
*.local

# --- Wreckognise runtime artefacts ---
backend/storage/uploads/*
backend/storage/processed/*
backend/storage/reports/*
